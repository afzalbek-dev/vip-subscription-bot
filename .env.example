# ==============================================================================
# VIP Subscription Bot Configuration Environment Variables
# Copy this file to .env and provide your specific credentials.
# NEVER commit the actual .env file to Git!
# ==============================================================================

# Telegram Bot Credentials
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
ADMIN_IDS=123456789,987654321
VIP_CHANNEL_ID=-1001234567890

# Database Settings (SQLite by default, PostgreSQL supported)
DATABASE_URL=sqlite:///data/vip_bot.db

# App & Worker Settings
APP_ENV=development
LOG_LEVEL=INFO
EXPIRY_CHECK_INTERVAL_SECONDS=60
REMINDER_HOURS_BEFORE_EXPIRY=24

# Payment System Details (Displayed to users for manual transfer / invoices)
PAYME_CARD=8600000000000000
CLICK_CARD=8600000000000000
CRYPTO_USDT_TRC20=Txxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CARD_HOLDER_NAME=AFZALBEK D.
